{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers, so an older runtime writes to the wrong
 ;; place rather than failing.
 ;;
 ;; This floor does NOT catch that, and it is worth being exact about why,
 ;; because it reads as though it does. jolt honours :jolt/min-version only
 ;; from jolt-lang/jolt#804, which merged 17 minutes after #802 reversed the
 ;; arguments. Anything old enough to have the old order is therefore too old
 ;; to read this key, and skips it. Measured on the released v0.7.29 with this
 ;; floor in place: it ran rather than refusing, dropped two test namespaces
 ;; with "ERROR requiring ... : nil", and still reported 0 failures, on 19 of
 ;; the suite's 37 tests.
 ;;
 ;; What actually pins the runtime is JOLT_VERSION in .github/workflows/ci.yml.
 ;; The floor is here for the NEXT break, where both sides can read the key,
 ;; and to state the requirement for anyone consuming this as a library. Note
 ;; that a floor on a library binds its CONSUMERS as well, so raising it is not
 ;; a local decision.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 ;; glitter-uikit is an alternative RENDERER for glitter: glitter owns the
 ;; Replicant-style reconciler (glitter.core) and the IRender/IMemory protocols
 ;; (glitter.protocols), and knows nothing about any toolkit; this project
 ;; supplies AppKit views, the prop/event wiring, and the NSApplication loop.
 ;;
 ;; AppKit is NOT declared under :jolt/native — glitter-uikit.ffi dlopens the
 ;; frameworks itself, guarded to macOS only, mirroring glimmer-uikit.
 ;;
 ;; Was previously a dependency on the full `glitter` package, which declares
 ;; GTK4/GLib/GObject/GIO under :jolt/native — jolt inherits a dependency's
 ;; natives transitively, so GTK4 was on the hook to be installed to run
 ;; anything here, even though this renderer never calls a GTK function. Fixed
 ;; by depending on `glitter-core` directly instead: the natives-free
 ;; extraction of glitter.core/glitter.protocols/glitter.alias (same names,
 ;; same code, no :jolt/native declaration anywhere in its own deps.edn).
 ;; `nexus-jolt` is added alongside it because examples/flights.clj,
 ;; temperature.clj and todo.clj dispatch through nexus.registry for real
 ;; (not test-only), so it belongs in top-level :deps rather than an alias.
 ;;
 ;; Dependency form: :local/root, NOT a pinned git coordinate — neither
 ;; glitter-core nor nexus-jolt has a commit pushed to its GitHub repo yet
 ;; (both are private, reserved names only, per the still-in-progress
 ;; glitter-core-extraction arc in jlt-commons/glitter). :local/root only
 ;; resolves on a machine with sibling ../glitter-core and ../nexus-jolt
 ;; checkouts, which is nobody outside this machine yet. Once both are
 ;; pushed, switch both entries to a pinned :git/url + :git/sha, mirroring
 ;; how this file used to pin glitter itself.
 ;; src/glitter_uikit/widget.clj requires hiccup2.core directly (a real
 ;; production dependency, not test-only — confirmed via grep before adding
 ;; it here rather than scoping it to :test). flights.clj/temperature.clj/
 ;; todo.clj log dispatch errors via clojure.tools.logging. Both used to
 ;; arrive transitively through glitter's own pins of these coordinates; now
 ;; declared directly since glitter is no longer in the graph. Same SHAs
 ;; glitter carries them at.
 :deps {io.github.jlt-commons/glitter-core {:local/root "../glitter-core"}
        io.github.jlt-commons/nexus-jolt {:local/root "../nexus-jolt"}
        weavejester/hiccup
        {:git/url "https://github.com/weavejester/hiccup"
         :git/sha "b6b12097ba973141fe87c1b4d6a27ddcce5d5929"}
        org.clojure/tools.logging
        {:git/url "https://github.com/jolt-lang/logging"
         :git/sha "ec6747e55583118d881faf4ab41e68d7e587ce4c"}}

 ;; Each runnable has its own alias with :main-opts (jolt's -M:alias form needs
 ;; main-opts). Tasks are thin wrappers so you can run `jolt counter`, etc.
 :aliases {:test    {:extra-paths ["test" "examples"]
                     :main-opts ["-m" "glitter-uikit.test-runner"]}
           :smoke   {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.smoke"]}
           :counter {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.counter"]}
           :reactivity-smoke {:extra-paths ["examples"]
                              :main-opts ["-m" "glitter-uikit.reactivity-smoke"]}
           :replace-child-smoke {:extra-paths ["examples"]
                                 :main-opts ["-m" "glitter-uikit.replace-child-smoke"]}
           :insert-before-smoke {:extra-paths ["examples"]
                                 :main-opts ["-m" "glitter-uikit.insert-before-smoke"]}
           :keyed-smoke {:extra-paths ["examples"]
                         :main-opts ["-m" "glitter-uikit.keyed-smoke"]}
           :handler-cleanup-smoke {:extra-paths ["examples"]
                                   :main-opts ["-m" "glitter-uikit.handler-cleanup-smoke"]}
           :todo {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.todo"]}
           :widgets {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.widgets"]}
           :temperature {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.temperature"]}
           :flights {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.flights"]}
           :timer {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.timer"]}
           :crud {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.crud"]}
           :circles {:extra-paths ["examples"] :main-opts ["-m" "glitter-uikit.circles"]}
           :main-thread-smoke {:extra-paths ["examples"]
                               :main-opts ["-m" "glitter-uikit.main-thread-smoke"]}
           :repl-live-smoke {:extra-paths ["examples"]
                             :main-opts ["-m" "glitter-uikit.repl-live-smoke"]}}

 :tasks {test "jolt -M:test"
         smoke "jolt -M:smoke"
         counter "jolt -M:counter"
         reactivity-smoke "jolt -M:reactivity-smoke"
         replace-child-smoke "jolt -M:replace-child-smoke"
         insert-before-smoke "jolt -M:insert-before-smoke"
         keyed-smoke "jolt -M:keyed-smoke"
         handler-cleanup-smoke "jolt -M:handler-cleanup-smoke"
         todo "jolt -M:todo"
         widgets "jolt -M:widgets"
         temperature "jolt -M:temperature"
         flights "jolt -M:flights"
         timer "jolt -M:timer"
         crud "jolt -M:crud"
         circles "jolt -M:circles"
         main-thread-smoke "jolt -M:main-thread-smoke"
         repl-live-smoke "jolt -M:repl-live-smoke"}}
